generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String                @id @default(uuid())
  name             String
  email            String                @unique
  password         String
  savingsGoal          Float                 @default(0.0) // Meta opcional de poupança
  role                 String                @default("user") // "user" | "admin"
  status               String                @default("active") // "active" | "suspended" | "pending"
  lastLogin            DateTime?
  twoFactorEnabled     Boolean               @default(false)
  twoFactorSecret      String?
  twoFactorTempCode    String?
  twoFactorCodeExpires DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  fixedExpenses        FixedExpense[]
  fixedExpensePayments FixedExpensePayment[]
  variableExpenses     VariableExpense[]
  revenues             Revenue[]
  savings              Savings[]
  piggyBanks           PiggyBank[]
  creditCards          CreditCard[]
  creditCardPurchases  CreditCardPurchase[]
  creditCardInvoices   CreditCardInvoice[]
  receivables          Receivable[]
  receivableReceipts   ReceivableReceipt[]
  auditLogsTarget      AuditLog[]            @relation("AuditTargetUser")
}

model FixedExpense {
  id           String                   @id @default(uuid())
  userId       String
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description  String
  amount       Float
  dueDay       Int
  firstDueDate DateTime
  endDate      DateTime?
  category     String
  pixKey       String?
  isVariable   Boolean                  @default(false)
  variableType String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  payments     FixedExpensePayment[]
  adjustments  FixedExpenseAdjustment[]
}

model FixedExpenseAdjustment {
  id             String       @id @default(uuid())
  fixedExpenseId String
  fixedExpense   FixedExpense @relation(fields: [fixedExpenseId], references: [id], onDelete: Cascade)
  startMonth     Int          // 1 - 12
  startYear      Int          // e.g. 2026, 2027
  amount         Float        // New recurring amount from this month/year forward
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([fixedExpenseId, startYear, startMonth])
}

model FixedExpensePayment {
  id             String       @id @default(uuid())
  fixedExpenseId String
  fixedExpense   FixedExpense @relation(fields: [fixedExpenseId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  month          Int          // 1 - 12
  year           Int          // 2025, 2026, etc.
  isPaid         Boolean      @default(false)
  paidAt         DateTime?
  amount         Float?       // Custom amount override for this specific month (e.g. Fatura Nubank, Luz)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([fixedExpenseId, month, year])
}

model VariableExpense {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  date        DateTime
  category    String
  pixKey      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Revenue {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  date        DateTime
  category    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  receivables        Receivable[]
  receivableReceipts ReceivableReceipt[]
}

model PiggyBank {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  targetAmount Float     @default(0)
  targetDate   DateTime?
  category     String    @default("general")
  color        String    @default("#15803d")
  icon         String    @default("piggy")
  description  String?
  isOngoing    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  savings      Savings[]
}

model Savings {
  id               String     @id @default(uuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  piggyBankId      String?
  piggyBank        PiggyBank? @relation(fields: [piggyBankId], references: [id], onDelete: Cascade)
  description      String
  amount           Float
  date             DateTime
  objective        String     @default("Poupança")
  isInitialBalance Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model CreditCard {
  id           String                  @id @default(uuid())
  userId       String
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String                  // Ex: "Nubank", "Inter Black", "Itaú"
  limit        Float                   @default(0) // Limite total
  dueDay       Int                     // Dia de vencimento da fatura (1 - 31)
  closingDay   Int                     // Dia de melhor compra / fechamento da fatura (1 - 31)
  color        String                  @default("#8b5cf6") // Cor do cartão
  brand        String                  @default("Mastercard") // Mastercard, Visa, Elo, etc.
  digits       String?                 // Últimos 4 dígitos (opcional)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  purchases    CreditCardPurchase[]
  installments CreditCardInstallment[]
  invoices     CreditCardInvoice[]
}

model CreditCardPurchase {
  id                String                  @id @default(uuid())
  creditCardId      String
  creditCard        CreditCard              @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  userId            String
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  description       String
  totalAmount       Float
  installmentsCount Int                     @default(1)
  purchaseDate      DateTime
  category          String                  @default("Outros")
  isThirdParty      Boolean                 @default(false)
  thirdPartyName    String?
  thirdPartyAmount  Float?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  installments      CreditCardInstallment[]
  receivables       Receivable[]
}

model CreditCardInstallment {
  id                String             @id @default(uuid())
  purchaseId        String
  purchase          CreditCardPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  creditCardId      String
  creditCard        CreditCard         @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  installmentNumber Int                // 1, 2, 3...
  totalInstallments Int                // total de parcelas (ex: 10)
  amount            Float              // valor desta parcela
  month             Int                // mês da fatura (1 - 12)
  year              Int                // ano da fatura (ex: 2026)
  isThirdParty      Boolean            @default(false)
  thirdPartyName    String?
  thirdPartyAmount  Float?
  createdAt         DateTime           @default(now())
  receivables       Receivable[]

  @@index([creditCardId, month, year])
  @@index([month, year])
}

model CreditCardInvoice {
  id               String       @id @default(uuid())
  creditCardId     String
  creditCard       CreditCard   @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  month            Int          // 1 - 12
  year             Int          // 2026, 2027...
  isPaid           Boolean      @default(false)
  paidAt           DateTime?
  manualAdjustment Float?       // Ajuste manual opcional no valor da fatura
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([creditCardId, month, year])
}

model Receivable {
  id                      String                 @id @default(uuid())
  userId                  String
  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  description             String
  amount                  Float
  dueDate                 DateTime               // Data prevista para recebimento (ou primeiro vencimento)
  dueDay                  Int?                   // Dia do mês de vencimento (1 - 31)
  endDate                 DateTime?              // Data final (opcional): se informada, repete até esta data
  isRecurring             Boolean                @default(false)
  isSale                  Boolean                @default(false) // Se for Venda, soma e lista em Minha renda ao receber
  category                String                 @default("Outros")
  payer                   String?                // De quem vai receber (ex: devedor ou terceiro)
  isReceived              Boolean                @default(false)
  receivedAt              DateTime?              // Data da efetivação do recebimento
  notes                   String?
  creditCardPurchaseId    String?
  creditCardPurchase      CreditCardPurchase?    @relation(fields: [creditCardPurchaseId], references: [id], onDelete: Cascade)
  creditCardInstallmentId String?
  creditCardInstallment   CreditCardInstallment? @relation(fields: [creditCardInstallmentId], references: [id], onDelete: Cascade)
  revenueId               String?
  revenue                 Revenue?               @relation(fields: [revenueId], references: [id], onDelete: SetNull)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  receipts                ReceivableReceipt[]
  adjustments             ReceivableAdjustment[]

  @@index([userId, dueDate])
  @@index([userId, isReceived])
}

model ReceivableAdjustment {
  id           String     @id @default(uuid())
  receivableId String
  receivable   Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  startMonth   Int        // 1 - 12
  startYear    Int        // 2026, 2027...
  amount       Float      // Novo valor recorrente a partir deste mês/ano em diante
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([receivableId, startYear, startMonth])
}

model ReceivableReceipt {
  id           String     @id @default(uuid())
  receivableId String
  receivable   Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  month        Int        // 1 - 12
  year         Int        // 2026, 2027...
  isReceived   Boolean    @default(false)
  receivedAt   DateTime?
  amount       Float?     // Ajuste customizado pontual para este mês específico
  revenueId    String?
  revenue      Revenue?   @relation(fields: [revenueId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([receivableId, month, year])
  @@index([userId, month, year])
}

model AuditLog {
  id              String   @id @default(uuid())
  adminId         String
  adminEmail      String
  action          String   // e.g. "BAN_USER", "ACTIVATE_USER", "SUSPEND_USER", "CHANGE_ROLE", "DELETE_USER", "SEND_PASSWORD_RESET"
  targetUserId    String?
  targetUserEmail String?
  details         String?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())
  targetUser      User?    @relation("AuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model SystemErrorLog {
  id         String   @id @default(uuid())
  endpoint   String
  method     String
  statusCode Int
  message    String
  stack      String?
  userId     String?
  userEmail  String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([statusCode])
  @@index([createdAt])
}

model SecurityLog {
  id        String   @id @default(uuid())
  email     String
  ipAddress String?
  userAgent String?
  status    String   // "SUCCESS" | "FAILED_PASSWORD" | "USER_NOT_FOUND" | "SUSPENDED" | "2FA_REQUIRED" | "2FA_FAILED"
  reason    String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([status])
  @@index([createdAt])
}


