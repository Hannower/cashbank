generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String                @id @default(uuid())
  name             String
  email            String                @unique
  password         String
  savingsGoal      Float                 @default(2720.0) // Target amount for savings goal (e.g. 1850 / 2720 = ~68%)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  fixedExpenses    FixedExpense[]
  fixedExpensePayments FixedExpensePayment[]
  variableExpenses VariableExpense[]
  revenues         Revenue[]
  savings          Savings[]
  piggyBanks       PiggyBank[]
  creditCards      CreditCard[]
  creditCardPurchases CreditCardPurchase[]
  creditCardInvoices  CreditCardInvoice[]
}

model FixedExpense {
  id           String                   @id @default(uuid())
  userId       String
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description  String
  amount       Float
  dueDay       Int
  firstDueDate DateTime
  endDate      DateTime?
  category     String
  pixKey       String?
  isVariable   Boolean                  @default(false)
  variableType String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  payments     FixedExpensePayment[]
  adjustments  FixedExpenseAdjustment[]
}

model FixedExpenseAdjustment {
  id             String       @id @default(uuid())
  fixedExpenseId String
  fixedExpense   FixedExpense @relation(fields: [fixedExpenseId], references: [id], onDelete: Cascade)
  startMonth     Int          // 1 - 12
  startYear      Int          // e.g. 2026, 2027
  amount         Float        // New recurring amount from this month/year forward
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([fixedExpenseId, startYear, startMonth])
}

model FixedExpensePayment {
  id             String       @id @default(uuid())
  fixedExpenseId String
  fixedExpense   FixedExpense @relation(fields: [fixedExpenseId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  month          Int          // 1 - 12
  year           Int          // 2025, 2026, etc.
  isPaid         Boolean      @default(false)
  paidAt         DateTime?
  amount         Float?       // Custom amount override for this specific month (e.g. Fatura Nubank, Luz)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([fixedExpenseId, month, year])
}

model VariableExpense {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  date        DateTime
  category    String
  pixKey      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Revenue {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  date        DateTime
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PiggyBank {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  targetAmount Float     @default(0)
  targetDate   DateTime?
  category     String    @default("general")
  color        String    @default("#15803d")
  icon         String    @default("piggy")
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  savings      Savings[]
}

model Savings {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  piggyBankId String?
  piggyBank   PiggyBank? @relation(fields: [piggyBankId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  date        DateTime
  objective   String     @default("Poupança")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model CreditCard {
  id           String                  @id @default(uuid())
  userId       String
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String                  // Ex: "Nubank", "Inter Black", "Itaú"
  limit        Float                   @default(0) // Limite total
  dueDay       Int                     // Dia de vencimento da fatura (1 - 31)
  closingDay   Int                     // Dia de melhor compra / fechamento da fatura (1 - 31)
  color        String                  @default("#8b5cf6") // Cor do cartão
  brand        String                  @default("Mastercard") // Mastercard, Visa, Elo, etc.
  digits       String?                 // Últimos 4 dígitos (opcional)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  purchases    CreditCardPurchase[]
  installments CreditCardInstallment[]
  invoices     CreditCardInvoice[]
}

model CreditCardPurchase {
  id                String                  @id @default(uuid())
  creditCardId      String
  creditCard        CreditCard              @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  userId            String
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  description       String
  totalAmount       Float
  installmentsCount Int                     @default(1)
  purchaseDate      DateTime
  category          String                  @default("Outros")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  installments      CreditCardInstallment[]
}

model CreditCardInstallment {
  id                String             @id @default(uuid())
  purchaseId        String
  purchase          CreditCardPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  creditCardId      String
  creditCard        CreditCard         @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  installmentNumber Int                // 1, 2, 3...
  totalInstallments Int                // total de parcelas (ex: 10)
  amount            Float              // valor desta parcela
  month             Int                // mês da fatura (1 - 12)
  year              Int                // ano da fatura (ex: 2026)
  createdAt         DateTime           @default(now())

  @@index([creditCardId, month, year])
  @@index([month, year])
}

model CreditCardInvoice {
  id               String       @id @default(uuid())
  creditCardId     String
  creditCard       CreditCard   @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  month            Int          // 1 - 12
  year             Int          // 2026, 2027...
  isPaid           Boolean      @default(false)
  paidAt           DateTime?
  manualAdjustment Float?       // Ajuste manual opcional no valor da fatura
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([creditCardId, month, year])
}

